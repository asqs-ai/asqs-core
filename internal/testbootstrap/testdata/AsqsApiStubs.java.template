package com.asqs.e2e;

import java.util.function.Consumer;

import com.microsoft.playwright.Page;
import com.microsoft.playwright.Route;

/**
 * Generated by ASQS e2e_framework_bootstrap — safe to edit or delete.
 *
 * <p>
 * Route-control helpers for E2E tests. Use them whenever a test asserts on something the
 * application renders FROM ITS API: the test decides what comes back, so the assertion
 * has a known answer and does not depend on a server being up.
 *
 * <p>
 * URL PATTERNS — read this before choosing one. A pattern is matched against the whole
 * URL, so it can match the page navigation as well as the API call. A pattern of
 * "star-star slash catalog star" matches both /api/catalog?q=x AND the page route
 * /catalog; fulfilling the navigation with JSON means the application never loads and
 * every locator then "does not exist". Include the API's own path segment so only the
 * request is intercepted.
 */
public final class AsqsApiStubs {

	private AsqsApiStubs() {
	}

	/**
	 * Answer every matching request with json. Register before the navigation that
	 * triggers it.
	 */
	public static void stubJson(Page page, String urlPattern, String json) {
		stubJson(page, urlPattern, json, 200);
	}

	/** Answer every matching request with json and an explicit status. */
	public static void stubJson(Page page, String urlPattern, String json, int status) {
		page.route(urlPattern, route -> route
			.fulfill(new Route.FulfillOptions().setStatus(status).setContentType("application/json").setBody(json)));
	}

	/**
	 * Answer after delayMillis, holding the request open in between.
	 *
	 * <p>
	 * This is how a transient state becomes observable. A spinner shown while a request
	 * is in flight is gone the moment it settles — against a stubbed or absent backend
	 * that is the next tick, far sooner than any assertion can poll — so a test that
	 * asserts on one must hold the response. Route has no delay member; the wait belongs
	 * inside the handler.
	 */
	public static void stubJsonAfter(Page page, String urlPattern, String json, long delayMillis) {
		page.route(urlPattern, route -> {
			try {
				Thread.sleep(delayMillis);
			}
			catch (InterruptedException ex) {
				Thread.currentThread().interrupt();
			}
			route.fulfill(new Route.FulfillOptions().setStatus(200).setContentType("application/json").setBody(json));
		});
	}

	/**
	 * Fail every matching request, for tests that assert on the application's error
	 * handling.
	 */
	public static void stubError(Page page, String urlPattern, int status) {
		page.route(urlPattern,
				route -> route.fulfill(new Route.FulfillOptions().setStatus(status)
					.setContentType("application/json")
					.setBody("{\"message\":\"stubbed failure\"}")));
	}

	/** Escape hatch for a handler this class does not cover. */
	public static void route(Page page, String urlPattern, Consumer<Route> handler) {
		page.route(urlPattern, handler);
	}

}
